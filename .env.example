# Copy to .env and fill in. .env is git-ignored -- never commit real credentials.
# Any OpenAI-compatible chat-completions endpoint works; the runs in this repo used the class-provided one.
OPENAI_BASE_URL=http://<your-endpoint-host>:<port>/v1
OPENAI_API_KEY=<your-api-key>
OPENAI_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
